<svg width="256" height="256" viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Definisi Gradien RAZ Enterprise -->
  <defs>
    <linearGradient id="razGradientBg" x1="20" y1="20" x2="236" y2="236" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#2563EB"/>
      <stop offset="100%" stop-color="#1D4ED8"/>
    </linearGradient>
    <linearGradient id="razAccent" x1="80" y1="60" x2="200" y2="200" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#F97316"/>
      <stop offset="100%" stop-color="#EA580C"/>
    </linearGradient>
    <filter id="razShadow" x="10" y="10" width="236" height="240" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#1E3A8A" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Latar Belakang Kotak Membulat Modern -->
  <rect x="24" y="24" width="208" height="208" rx="52" fill="url(#razGradientBg)" filter="url(#razShadow)"/>

  <!-- Lipatan Dokumen Elegan di Sudut Kanan Atas -->
  <path d="M168 24L232 88H184C175.163 88 168 80.8366 168 72V24Z" fill="white" fill-opacity="0.25"/>

  <!-- Huruf R Bergaya Enterprise Modern -->
  <!-- Batang Tegak Kiri -->
  <rect x="68" y="72" width="26" height="112" rx="10" fill="white"/>

  <!-- Busur Kepala Huruf R Atas -->
  <path d="M68 72H134C156.091 72 172 86.3269 172 106C172 125.673 156.091 140 134 140H94V72" stroke="white" stroke-width="26" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- Kaki Dinamis Huruf R dengan Aksen Enerjik RAZ -->
  <path d="M124 134L174 184" stroke="url(#razAccent)" stroke-width="26" stroke-linecap="round"/>

  <!-- Titik Aksen Oranye RAZ -->
  <circle cx="186" cy="184" r="8" fill="#FDBA74"/>
</svg>
