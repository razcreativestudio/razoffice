# ==============================================================================
# RAZ Office - Apache / LiteSpeed Configuration for cPanel (IDwebhost)
# ==============================================================================

# 1. Matikan Directory Browsing agar LiteSpeed tidak pernah menampilkan "Index of /"
Options -Indexes

# 2. Utamakan index.html sebagai halaman utama setiap folder
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nonaktifkan kompresi dinamis LiteSpeed untuk aset engine x2t agar tidak merusak eksekusi Web Worker
  RewriteRule ^x2t.* - [E=no-gzip:1,E=no-brotli:1]

  # Jika file atau folder memang ada di server, langsung sajikan
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Dukungan routing untuk folder yang memiliki index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # Fallback halaman tidak ditemukan (404)
  ErrorDocument 404 /404/index.html
</IfModule>

# Cegah kompresi dinamis server untuk folder x2t
<IfModule mod_env.c>
  SetEnvIf Request_URI "^/x2t" no-gzip 1 no-brotli 1
</IfModule>

# ==============================================================================
# MIME Types untuk WebAssembly & Aset Modern
# ==============================================================================
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddEncoding gzip .svgz
  AddType application/octet-stream .raw
</IfModule>

# ==============================================================================
# Content-Encoding Brotli untuk Core Engine WASM (x2t) & Cache Statis
# ==============================================================================
<IfModule mod_headers.c>
  # File biner WebAssembly x2t dikompresi menggunakan Brotli (.wasm / .br)
  # Pastikan file JavaScript (.js) tidak dikenakan header br statis agar tidak memicu double compression di LiteSpeed
  <FilesMatch "(^x2t.*\.wasm$|\.br$)">
    Header set Content-Encoding br
    Header set Cache-Control "public, max-age=31556952, immutable"
  </FilesMatch>

  # Jangan simpan cache untuk HTML dan skrip API agar browser selalu memuat kode terbaru
  <FilesMatch "(index\.html$|api\.js$)">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache browser untuk aset statis agar loading instan
  <FilesMatch "\.(css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31556952, immutable"
  </FilesMatch>
</IfModule>
