# ==============================================================================
# RAZ Office - Apache / LiteSpeed Configuration for cPanel (IDwebhost)
# ==============================================================================

# 1. Matikan Directory Browsing agar LiteSpeed tidak pernah menampilkan "Index of /"
Options -Indexes

# 2. Utamakan index.html sebagai halaman utama setiap folder
DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jika file atau folder memang ada di server, langsung sajikan
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Dukungan routing untuk folder yang memiliki index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # Fallback halaman tidak ditemukan (404)
  ErrorDocument 404 /404/index.html
</IfModule>

# ==============================================================================
# MIME Types untuk WebAssembly & Aset Modern
# ==============================================================================
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddEncoding gzip .svgz
</IfModule>

# ==============================================================================
# Content-Encoding Brotli untuk Core Engine WASM (x2t) & Cache Statis
# ==============================================================================
<IfModule mod_headers.c>
  # File biner x2t dikompresi menggunakan Brotli (.br)
  <FilesMatch "^x2t.*">
    Header set Content-Encoding br
    Header set Cache-Control "public, max-age=31556952, immutable"
  </FilesMatch>

  <FilesMatch "\.wasm$">
    Header set Cache-Control "public, max-age=31556952, immutable"
  </FilesMatch>

  # Cache browser untuk aset statis agar loading instan
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31556952, immutable"
  </FilesMatch>
</IfModule>
